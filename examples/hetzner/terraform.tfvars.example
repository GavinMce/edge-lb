ssh_public_key     = "ssh-ed25519 AAAA... you@host"
cloudflare_zone_id = "0123456789abcdef0123456789abcdef"
home_public_key    = "output of `wg pubkey` on the home gateway"
ingress_ip         = "192.168.1.50"
blog_hosts         = ["example.com", "www.example.com"]

# Only needed for the first-boot key fetch; set back to [] afterwards and use the tunnel.
admin_ssh_cidrs = ["203.0.113.7/32"]
