#!/bin/sh
# edge-lb installer — generated by Terraform. Idempotent: safe to re-run.
# Installs WireGuard + HAProxy (+ an nftables policy) on a systemd Linux (apt or dnf).
# Run as root. Nothing here is secret; the WireGuard private key is generated on this machine.
set -eu

IFACE='${wg_interface}'
FIREWALL='${firewall_mode}'
HARDEN_SSH='${harden_ssh}'
AUTO_UPDATES='${auto_updates}'
WG_DIR=/etc/wireguard
EDGE_DIR=/etc/edge-lb

log() { printf 'edge-lb: %s\n' "$*"; }
die() { printf 'edge-lb: ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
command -v systemctl >/dev/null 2>&1 || die "systemd is required"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# put MODE DEST  (content on stdin): install only when different.
# Returns 0 if the file changed, 1 if it was already up to date. Always call inside `if`.
put() {
  _tmp=$(mktemp)
  cat > "$_tmp"
  if [ -f "$2" ] && cmp -s "$_tmp" "$2"; then
    rm -f "$_tmp"
    return 1
  fi
  install -m "$1" "$_tmp" "$2"
  rm -f "$_tmp"
  return 0
}

# ---- 1. packages -------------------------------------------------------------------
install_packages() {
  if command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get -o DPkg::Lock::Timeout=300 update -qq
    apt-get -o DPkg::Lock::Timeout=300 install -y -qq wireguard-tools haproxy nftables iproute2
    if [ "$AUTO_UPDATES" = true ]; then
      apt-get -o DPkg::Lock::Timeout=300 install -y -qq unattended-upgrades
    fi
  elif command -v dnf >/dev/null 2>&1; then
    dnf -y -q install wireguard-tools haproxy nftables iproute
    if [ "$AUTO_UPDATES" = true ]; then
      # Best effort: dnf4 ships dnf-automatic-install.timer; dnf5 (Fedora 41+) differs and
      # needs apply_updates=yes in /etc/dnf/automatic.conf, which we don't touch.
      dnf -y -q install dnf-automatic || true
      systemctl enable --now dnf-automatic-install.timer 2>/dev/null \
        || log "warning: could not enable automatic updates; configure dnf-automatic yourself"
    fi
  else
    die "unsupported distro: need apt-get or dnf (or install wireguard-tools, haproxy, nftables yourself and re-run)"
  fi
}
log "installing packages"
install_packages
# Probe by creating an interface: modprobe alone is unreliable (built-in modules, containers).
modprobe wireguard 2>/dev/null || true
if ip link add edge-lb-probe type wireguard 2>/dev/null; then
  ip link del edge-lb-probe
else
  die "WireGuard kernel support is unavailable (some containers/LXC and old kernels lack it)"
fi

# ---- 2. render candidates and validate BEFORE changing anything -------------------------
printf '%s' '${haproxy_b64}'  | base64 -d > "$WORK/haproxy.cfg"
printf '%s' '${nftables_b64}' | base64 -d > "$WORK/edge-lb.nft"

haproxy -c -q -f "$WORK/haproxy.cfg" || die "generated HAProxy config is invalid; nothing was changed"
if [ "$FIREWALL" = strict ]; then
  nft -c -f "$WORK/edge-lb.nft" || die "generated nftables ruleset is invalid; nothing was changed"
fi

# ---- 3. WireGuard ------------------------------------------------------------------------
install -d -m 0700 "$WG_DIR"
if [ ! -s "$WG_DIR/$IFACE.key" ]; then
  log "generating WireGuard key for $IFACE"
  ( umask 077; wg genkey > "$WG_DIR/$IFACE.key" )
fi
wg pubkey < "$WG_DIR/$IFACE.key" > "$WG_DIR/$IFACE.pub"
chmod 0644 "$WG_DIR/$IFACE.pub"

wg_changed=0
if printf '%s' '${wg_conf_b64}' | base64 -d \
     | sed "s|__PRIVATE_KEY__|$(cat "$WG_DIR/$IFACE.key")|" \
     | put 0600 "$WG_DIR/$IFACE.conf"; then
  wg_changed=1
fi
systemctl enable "wg-quick@$IFACE" >/dev/null 2>&1
if [ "$wg_changed" -eq 1 ] || ! systemctl is-active --quiet "wg-quick@$IFACE"; then
  log "(re)starting wg-quick@$IFACE"
  systemctl restart "wg-quick@$IFACE"
fi

# ---- 4. HAProxy ------------------------------------------------------------------------
# SELinux blocks HAProxy from connecting to arbitrary ports by default.
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = Enforcing ] && command -v setsebool >/dev/null 2>&1; then
  setsebool -P haproxy_connect_any 1 || log "warning: could not set haproxy_connect_any"
fi

install -d /etc/systemd/system/haproxy.service.d
if put 0644 /etc/systemd/system/haproxy.service.d/edge-lb.conf <<'UNIT'
[Unit]
# Start after the tunnel exists at boot.
After=wg-quick@${wg_interface}.service
Wants=wg-quick@${wg_interface}.service
UNIT
then
  systemctl daemon-reload
fi

systemctl enable haproxy >/dev/null 2>&1
if put 0644 /etc/haproxy/haproxy.cfg < "$WORK/haproxy.cfg"; then
  log "HAProxy config changed; reloading"
  systemctl reload-or-restart haproxy
else
  systemctl start haproxy
fi

# ---- 5. Firewall (own nftables table; leaves other rules alone) --------------------------
FW_UNIT=/etc/systemd/system/edge-lb-firewall.service
if [ "$FIREWALL" = strict ]; then
  install -d "$EDGE_DIR"
  fw_changed=0
  if put 0644 "$EDGE_DIR/nftables.nft" < "$WORK/edge-lb.nft"; then fw_changed=1; fi
  if put 0644 "$FW_UNIT" <<'UNIT'
[Unit]
Description=edge-lb nftables policy
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env nft -f /etc/edge-lb/nftables.nft
ExecReload=/usr/bin/env nft -f /etc/edge-lb/nftables.nft
ExecStop=/usr/bin/env nft delete table inet edge_lb

[Install]
WantedBy=multi-user.target
UNIT
  then
    systemctl daemon-reload
    fw_changed=1
  fi
  systemctl enable edge-lb-firewall >/dev/null 2>&1
  if [ "$fw_changed" -eq 1 ] || ! systemctl is-active --quiet edge-lb-firewall; then
    log "applying firewall policy"
    systemctl restart edge-lb-firewall
  fi
elif [ -f "$FW_UNIT" ]; then
  log "firewall_mode is none: removing previously installed edge-lb firewall"
  systemctl disable --now edge-lb-firewall || true
  rm -f "$FW_UNIT" "$EDGE_DIR/nftables.nft"
  systemctl daemon-reload
fi

# ---- 6. SSH hardening (opt-in) -----------------------------------------------------------
if [ "$HARDEN_SSH" = true ]; then
  if [ -d /etc/ssh/sshd_config.d ] && grep -qs '^[[:space:]]*Include.*sshd_config.d' /etc/ssh/sshd_config; then
    SSHD=$(command -v sshd || echo /usr/sbin/sshd)
    # 00- sorts first, and sshd uses the first value it sees.
    if put 0644 /etc/ssh/sshd_config.d/00-edge-lb.conf <<'CONF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
CONF
    then
      if "$SSHD" -t; then
        systemctl reload ssh 2>/dev/null || systemctl reload sshd
      else
        rm -f /etc/ssh/sshd_config.d/00-edge-lb.conf
        die "sshd rejected the hardening drop-in; removed it"
      fi
    fi
  else
    log "skipping SSH hardening: sshd_config.d is not supported on this system"
  fi
fi

log "done. WireGuard public key for $IFACE:"
cat "$WG_DIR/$IFACE.pub"
